@using Wijha.Models
@using Wijha.Support
@{
    Layout = "~/Views/layouts/_admin.cshtml";
    ViewBag.Title = "Providers | Admin | Wijha";
    var providers = (LengthAwarePaginator<ServiceProvider>)ViewBag.Providers;
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    var cities = (IEnumerable<string>)ViewBag.Cities;
    var activity = (Dictionary<int, dynamic>)ViewBag.Activity;
    string q = ViewBag.Q as string ?? "";
    string view = ViewBag.View as string ?? "All";
    string city = ViewBag.City as string ?? "";
    var approvalMap = new Dictionary<string, string> {
        ["Pending"] = "b-warn", ["Approved"] = "b-ok", ["Rejected"] = "b-err"
    };
    var errors = new Wijha.Support.Http.ErrorBag(ViewContext);
}
<div class="page-pad">
    @await Html.PartialAsync("~/Views/partials/_flash.cshtml")
    @if (errors.Has("reason"))
    {
        <div class="alert-w a-err mb-3"><i class="bi bi-exclamation-circle-fill"></i><div><strong>Nothing was changed.</strong> @errors.First("reason")</div></div>
    }

    @await Html.PartialAsync("~/Views/components/_admin-head.cshtml", (object)new {
        eyebrow = "Manage",
        title = "Service providers",
        subtitle = "Approve new businesses, review their details and block accounts that break the rules.",
        actions = new[] {
            new { href = Url.RouteUrl("admin.reports.performance"), cls = "btn-w-ghost", icon = "graph-up-arrow", label = "Performance report" }
        }
    })

    @{ int pendingCount = counts.GetValueOrDefault("Pending", 0); }
    @if (pendingCount > 0 && view != "Pending")
    {
        <div class="alert-w a-info mb-3">
            <i class="bi bi-hourglass-split" style="font-size:18px;"></i>
            <div><strong>@pendingCount @(pendingCount == 1 ? "provider" : "providers") waiting for approval.</strong>
                <a href="@Url.RouteUrl("admin.providers.index", new { view = "Pending" })" style="color:inherit;font-weight:700;">Review now</a></div>
        </div>
    }

    <form method="GET" action="@Url.RouteUrl("admin.providers.index")" class="a-filters">
        <input type="hidden" name="view" value="@(view == "All" ? "" : view)">
        <div class="date-filter">
            <div class="date-filter-field f-search">
                <label class="lbl d-block mb-2" for="q">Search</label>
                <div class="inp-icon"><i class="bi bi-search"></i>
                    <input type="search" name="q" id="q" class="inp" value="@q" placeholder="Business, owner, email, phone, CR number"></div>
            </div>
            <div class="date-filter-field">
                <label class="lbl d-block mb-2" for="city">City</label>
                <select name="city" id="city" class="inp" onchange="this.form.submit()">
                    <option value="">All cities</option>
                    @foreach (var c in cities)
                    {
                        <option value="@c" @(city == c ? "selected" : "")>@c</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-w btn-sm-w date-filter-btn">Search</button>
            @if (q != "" || !string.IsNullOrEmpty(city))
            {
                <a href="@Url.RouteUrl("admin.providers.index", view == "All" ? (object)new { } : new { view })" class="btn btn-w-ghost btn-sm-w date-filter-btn">Clear</a>
            }
        </div>
    </form>

    <div class="d-flex gap-2 flex-wrap mb-3">
        @foreach (var kv in counts)
        {
            <a href="@Url.RouteUrl("admin.providers.index", kv.Key == "All" ? (object)new { } : new { view = kv.Key })"
               class="chip btn-sm-w @(view == kv.Key ? "chip-on" : "")">@(kv.Key == "Pending" ? "Waiting for approval" : kv.Key) (@kv.Value)</a>
        }
    </div>

    <div class="a-table-wrap">
        <table class="a-table" style="min-width:960px;">
            <thead><tr><th>Business</th><th>Owner &middot; contact</th><th>City</th><th class="num">Services</th><th class="num">Requests</th><th class="num">Rating</th><th>Status</th><th class="num">Actions</th></tr></thead>
            <tbody>
            @if (providers.Items.Any())
            {
                @foreach (var provider in providers.Items)
                {
                    dynamic act = activity.GetValueOrDefault(provider.ProviderId);
                    string initials = provider.BusinessName.Substring(0, Math.Min(2, provider.BusinessName.Length)).ToUpper();
                    int requests = (int)(act?.requests ?? 0);
                    int completed = (int)(act?.completed ?? 0);
                    <tr>
                        <td><div class="d-flex align-items-center gap-2">
                            @await Html.PartialAsync("~/Views/components/_avatar.cshtml", (object)new { url = Wijha.Helpers.WijhaHelpers.ImageUrl(provider.LogoUrl), initials, size = 36 })
                            <div style="min-width:0;"><strong>@provider.BusinessName</strong><div class="sub">Joined @provider.RegistrationDate.ToString("j MMM yyyy")</div></div>
                        </div></td>
                        <td>@provider.OwnerName<div class="sub">@provider.Email</div><div class="sub">@provider.Phone</div></td>
                        <td>@provider.City</td>
                        <td class="num">@(provider.ProviderServicesCount ?? 0)</td>
                        <td class="num">@requests<div class="sub">@completed completed</div></td>
                        <td class="num"><i class="bi bi-star-fill" style="color:var(--w-sand-400);font-size:12px;"></i> @provider.AverageRating.ToString("F1")<div class="sub">@provider.TotalReviews reviews</div></td>
                        <td style="white-space:nowrap;"><span class="badge-w @(approvalMap.GetValueOrDefault(provider.ApprovalStatus, "b-grey"))">@(provider.ApprovalStatus == "Pending" ? "Waiting" : provider.ApprovalStatus)</span>
                            <div class="sub mt-1" @(provider.AccountStatus == "Blocked" ? Html.Raw("style=\"color:#9C4A3C;font-weight:700;\"") : Html.Raw(""))><i class="bi bi-@(provider.AccountStatus == "Blocked" ? "lock-fill" : "unlock") me-1"></i>@provider.AccountStatus</div></td>
                        <td><div class="a-actions">
                            <button type="button" class="btn btn-w-ghost btn-sm-w" data-bs-toggle="modal" data-bs-target="#view-@provider.ProviderId">View</button>
                            @if (provider.ApprovalStatus == "Pending")
                            {
                                <form method="POST" action="@Url.RouteUrl("admin.providers.decide", new { id = provider.ProviderId })"
                                      data-confirm="@provider.BusinessName will be able to publish services and receive bookings. Their 1-year subscription starts today."
                                      data-confirm-title="Approve this provider?" data-confirm-ok="Approve" data-confirm-icon="bi-patch-check">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="decision" value="approve">
                                    <button type="submit" class="btn btn-w btn-sm-w">Approve</button>
                                </form>
                                <button type="button" class="btn btn-w-danger btn-sm-w" data-bs-toggle="modal" data-bs-target="#reject-@provider.ProviderId">Reject</button>
                            }
                            @if (provider.AccountStatus == "Active")
                            {
                                <button type="button" class="btn btn-w-ghost btn-sm-w" style="color:var(--w-danger);" data-bs-toggle="modal" data-bs-target="#block-@provider.ProviderId">Block</button>
                            }
                            else
                            {
                                <form method="POST" action="@Url.RouteUrl("admin.providers.unblock", new { id = provider.ProviderId })"
                                      data-confirm="@provider.BusinessName will be able to log in and receive bookings again."
                                      data-confirm-title="Unblock this provider?" data-confirm-ok="Unblock" data-confirm-icon="bi-unlock">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-w-ghost btn-sm-w">Unblock</button>
                                </form>
                            }
                        </div></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="a-empty"><i class="bi bi-shop d-block mb-2" style="font-size:26px;"></i>No providers match your search.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="mt-3">@Html.Raw(providers.Links())</div>
</div>

@foreach (var provider in providers.Items)
{
    dynamic act = activity.GetValueOrDefault(provider.ProviderId);
    int requests = (int)(act?.requests ?? 0);
    int completed = (int)(act?.completed ?? 0);
    string initials = provider.BusinessName.Substring(0, Math.Min(2, provider.BusinessName.Length)).ToUpper();

    <div class="modal fade" id="view-@provider.ProviderId" tabindex="-1" aria-labelledby="view-title-@provider.ProviderId">
        <div class="modal-dialog modal-dialog-scrollable modal-lg"><div class="modal-content" style="border-radius:var(--r-xl);border:0;">
            <div class="modal-body" style="padding:28px;">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @await Html.PartialAsync("~/Views/components/_avatar.cshtml", (object)new { url = Wijha.Helpers.WijhaHelpers.ImageUrl(provider.LogoUrl), initials, size = 56 })
                    <div class="flex-grow-1" style="min-width:0;">
                        <h2 class="h-sec mb-1" id="view-title-@provider.ProviderId">@provider.BusinessName</h2>
                        <span class="badge-w @(approvalMap.GetValueOrDefault(provider.ApprovalStatus, "b-grey"))">@provider.ApprovalStatus</span>
                        <span class="badge-w @(provider.AccountStatus == "Active" ? "b-ok" : "b-err")">@provider.AccountStatus</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(provider.BusinessDescription))
                {
                    <p class="muted" style="font-size:14.5px;line-height:1.65;">@provider.BusinessDescription</p>
                }
                <div class="row">
                    <div class="col-md-6">
                        <div class="lbl mt-2 mb-1">Business</div>
                        <div class="sum-row"><span class="k">Owner</span><span class="v">@provider.OwnerName</span></div>
                        <div class="sum-row"><span class="k">Commercial register</span><span class="v">@provider.CommercialRegisterNo</span></div>
                        <div class="sum-row"><span class="k">City</span><span class="v">@provider.City</span></div>
                        <div class="sum-row"><span class="k">Address</span><span class="v" style="max-width:60%;overflow-wrap:anywhere;">@(string.IsNullOrEmpty(provider.BusinessAddress) ? "Not set" : provider.BusinessAddress)</span></div>
                        <div class="sum-row"><span class="k">Email</span><span class="v" style="overflow-wrap:anywhere;">@provider.Email</span></div>
                        <div class="sum-row"><span class="k">Phone</span><span class="v">@provider.Phone</span></div>
                    </div>
                    <div class="col-md-6">
                        <div class="lbl mt-2 mb-1">On Wijha</div>
                        <div class="sum-row"><span class="k">Registered</span><span class="v">@provider.RegistrationDate.ToString("j MMM yyyy")</span></div>
                        <div class="sum-row"><span class="k">Subscription</span><span class="v">@(provider.SubscriptionStartDate.HasValue ? provider.SubscriptionStartDate.Value.ToString("j MMM yyyy") + " – " + provider.SubscriptionEndDate!.Value.ToString("j MMM yyyy") : "Not started")</span></div>
                        <div class="sum-row"><span class="k">Services listed</span><span class="v">@(provider.ProviderServicesCount ?? 0)</span></div>
                        <div class="sum-row"><span class="k">Requests received</span><span class="v">@requests</span></div>
                        <div class="sum-row"><span class="k">Completed jobs</span><span class="v">@completed</span></div>
                        <div class="sum-row"><span class="k">Rating</span><span class="v">@provider.AverageRating.ToString("F1") (@provider.TotalReviews)</span></div>
                    </div>
                </div>
            </div>
            <div class="modal-foot d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-w-ghost" data-bs-dismiss="modal">Close</button>
                @if (provider.ApprovalStatus == "Approved")
                {
                    <a href="@Url.RouteUrl("providers.show", new { id = provider.ProviderId })" target="_blank" class="btn btn-w-ghost"><i class="bi bi-box-arrow-up-right me-1"></i>Store page</a>
                }
                <a href="@Url.RouteUrl("admin.bookings.index", new { provider_id = provider.ProviderId })" class="btn btn-w ms-auto">See bookings</a>
            </div>
        </div></div>
    </div>

    @if (provider.ApprovalStatus == "Pending")
    {
        <div class="modal fade" id="reject-@provider.ProviderId" tabindex="-1" aria-labelledby="reject-title-@provider.ProviderId">
            <div class="modal-dialog"><div class="modal-content" style="border-radius:var(--r-xl);border:0;">
                <form method="POST" action="@Url.RouteUrl("admin.providers.decide", new { id = provider.ProviderId })"
                      data-confirm="@provider.BusinessName will not be able to publish services. This is recorded with your reason."
                      data-confirm-title="Reject this provider?" data-confirm-ok="Reject" data-confirm-tone="danger">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="decision" value="reject">
                    <div class="modal-body" style="padding:28px;">
                        <h2 class="h-sec mb-3" id="reject-title-@provider.ProviderId">Reject @provider.BusinessName</h2>
                        <div class="field mb-0">
                            <label for="rr-@provider.ProviderId">Reason <span style="color:var(--w-danger);">*</span></label>
                            <textarea name="reason" id="rr-@provider.ProviderId" class="inp inp-area" rows="3" maxlength="500" required placeholder="e.g. The commercial register number could not be verified."></textarea>
                        </div>
                    </div>
                    <div class="modal-foot d-flex gap-2">
                        <button type="button" class="btn btn-w-ghost flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-w-danger-fill flex-grow-1">Continue</button>
                    </div>
                </form>
            </div></div>
        </div>
    }

    @if (provider.AccountStatus == "Active")
    {
        <div class="modal fade" id="block-@provider.ProviderId" tabindex="-1" aria-labelledby="block-title-@provider.ProviderId">
            <div class="modal-dialog"><div class="modal-content" style="border-radius:var(--r-xl);border:0;">
                <form method="POST" action="@Url.RouteUrl("admin.providers.block", new { id = provider.ProviderId })"
                      data-confirm="@provider.BusinessName will be logged out and cannot log in or receive bookings until you unblock them."
                      data-confirm-title="Block this provider?" data-confirm-ok="Block" data-confirm-tone="danger">
                    @Html.AntiForgeryToken()
                    <div class="modal-body" style="padding:28px;">
                        <h2 class="h-sec mb-3" id="block-title-@provider.ProviderId">Block @provider.BusinessName</h2>
                        <div class="field mb-0">
                            <label for="br-@provider.ProviderId">Reason <span style="color:var(--w-danger);">*</span></label>
                            <textarea name="reason" id="br-@provider.ProviderId" class="inp inp-area" rows="3" maxlength="500" required placeholder="Kept in the admin log."></textarea>
                        </div>
                    </div>
                    <div class="modal-foot d-flex gap-2">
                        <button type="button" class="btn btn-w-ghost flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-w-danger-fill flex-grow-1">Continue</button>
                    </div>
                </form>
            </div></div>
        </div>
    }
}
