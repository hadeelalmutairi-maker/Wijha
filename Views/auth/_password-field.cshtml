@model dynamic
@using Wijha.Support.Http
@{
    string id = Model?.id ?? "password";
    string name = Model?.name ?? "password";
    string label = Model?.label ?? "Password";
    string placeholder = Model?.placeholder ?? "";
    string autocomplete = Model?.autocomplete ?? "off";
    string? minlength = Model?.minlength?.ToString();
    string? pattern = Model?.pattern;
    string? title = Model?.title;
    bool invalid = Model?.invalid ?? false;
    var errors = new ErrorBag(ViewContext);
    bool hasError = errors.Has(name) || invalid;
}
<div class="field">
    <label for="@id">@Html.Raw(label)</label>
    <div class="inp-icon"><i class="bi bi-lock" @(hasError ? "style=\"color:var(--w-danger);\"" : "")></i>
        <input type="password" name="@name" id="@id" class="inp has-eye @(hasError ? "inp-err" : "")"
               placeholder="@placeholder" required autocomplete="@autocomplete"
               @(minlength != null ? $"minlength=\"{minlength}\"" : "")
               @(pattern != null ? $"pattern=\"{pattern}\" title=\"{title ?? ""}\"" : "")>
        <button type="button" class="pw-eye" data-pw-toggle="@id" aria-label="Show password"><i class="bi bi-eye"></i></button>
    </div>
    @if (errors.Has(name)) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First(name)</div> }
</div>
