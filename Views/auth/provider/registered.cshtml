@using Wijha.Models
@model Provider
@{
    Layout = null;
}
<!doctype html>
<html lang="en" dir="ltr">
<head>
@await Html.PartialAsync("~/Views/partials/_head.cshtml")
</head>
<body>
<div class="success-screen">
    <svg width="520" height="520" viewBox="0 0 520 520" fill="none" class="success-blob-a" aria-hidden="true"><circle cx="260" cy="260" r="260" fill="#3E5247"/></svg>
    <svg width="420" height="420" viewBox="0 0 420 420" fill="none" class="success-blob-b" aria-hidden="true"><circle cx="210" cy="210" r="210" fill="#4A5A4E"/></svg>

    <div class="success-inner">
        <svg width="124" height="124" viewBox="0 0 124 124" fill="none" style="display:block;margin:0 auto;" aria-hidden="true">
            <circle cx="62" cy="62" r="60" fill="#3E5247"/><circle cx="62" cy="62" r="48" fill="#D8BD9E"/>
            <path d="M44 63l13 13 24-26" stroke="#23342B" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 18l3.4 8.8 8.8 3.4-8.8 3.4-3.4 8.8-3.4-8.8-8.8-3.4 8.8-3.4L12 18z" fill="#CAA380"/>
            <path d="M110 80l2.6 6.8 6.8 2.6-6.8 2.6-2.6 6.8-2.6-6.8-6.8-2.6 6.8-2.6L110 80z" fill="#CAA380"/>
        </svg>
        <h1 class="h-pg mt-4" style="color:#F6F8F6;font-size:42px;">Your store is with our team</h1>
        <p class="mt-3" style="color:#C3D0C7;font-size:17px;line-height:1.75;max-width:520px;margin:0 auto;">
            Thanks, <strong style="color:#fff;">@Model.BusinessName</strong>.
            @if (Model.ApprovalStatus == "Approved")
            {
                <text>Your business is already approved, so you can publish services now.</text>
            }
            else
            {
                <text>An administrator is reviewing your commercial register now. We will email <strong style="color:#fff;">@Model.Email</strong> as soon as you are approved, usually within 1 to 2 working days.</text>
            }
        </p>

        <div class="card-w text-start mt-5" style="max-width:520px;margin:0 auto;padding:26px 28px;">
            <div class="lbl mb-3">What happens next</div>
            <div class="d-flex gap-3 mb-3">
                <span class="next-num done"><i class="bi bi-check-lg"></i></span>
                <div><div style="font-weight:700;font-size:15px;">Account created</div>
                    <div class="muted" style="font-size:13px;">@Model.RegistrationDate.ToString("dd MMM yyyy, HH:mm")</div></div>
            </div>
            <div class="d-flex gap-3 mb-3">
                <span class="next-num @(Model.ApprovalStatus == "Approved" ? "done" : "now")">
                    @if (Model.ApprovalStatus == "Approved") { <i class="bi bi-check-lg"></i> } else { <text>2</text> }
                </span>
                <div><div style="font-weight:700;font-size:15px;">@(Model.ApprovalStatus == "Approved" ? "Approved by Wijha" : "Admin review in progress")</div>
                    <div class="muted" style="font-size:13px;">Commercial register @Model.CommercialRegisterNo</div></div>
            </div>
            <div class="d-flex gap-3">
                <span class="next-num">3</span>
                <div><div style="font-weight:700;font-size:15px;@(Model.ApprovalStatus == "Approved" ? "" : "color:var(--w-green-400);")">Add your services and go live</div>
                    <div class="muted" style="font-size:13px;">@(Model.ApprovalStatus == "Approved" ? "Open My Services to publish your first offering" : "Available after approval")</div></div>
            </div>
        </div>

        <div class="d-flex gap-3 justify-content-center flex-wrap mt-5">
            <a href="@Url.RouteUrl("provider.dashboard")" class="btn btn-w-gold btn-lg-w">Go to my dashboard</a>
            <a href="@Url.RouteUrl("home")" class="btn btn-lg-w success-ghost">Back to home</a>
        </div>
    </div>
</div>
</body>
</html>
