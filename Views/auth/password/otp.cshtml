@{
    Layout = "~/Views/layouts/_auth.cshtml";
    ViewBag.Title = "Check your email | Wijha";
    string guard = ViewBag.Guard ?? "customer";
    string email = ViewBag.Email ?? "";
    DateTime sentAt = ViewBag.SentAt ?? DateTime.Now;
    int resendIn = ViewBag.ResendIn ?? 0;
}
@using Wijha.Support.Http
@{ var errors = new ErrorBag(ViewContext); }

@section quote {
    <div class="auth-quote">It happens.<br>Let us get you<br>back in.</div>
}

<a href="@Url.RouteUrl("password.forgot", new { guard })" class="muted d-inline-flex align-items-center gap-2 mb-4" style="font-size:14.5px;font-weight:700;text-decoration:none;">
    <i class="bi bi-arrow-left"></i> Use a different email</a>

@await Html.PartialAsync("~/Views/auth/password/_steps.cshtml", (object)new { current = 2, guard })

<h1 class="h-sec mb-2">Check your email</h1>
<p class="muted mb-4" style="font-size:15.5px;">We sent a 6-digit code to <strong style="color:var(--w-green-700);">@email</strong>. It expires in 10 minutes.</p>

<div class="alert-w a-ok mb-4">
    <i class="bi bi-envelope-check-fill" style="font-size:18px;"></i>
    <div>Reset code sent at @sentAt.ToString("HH:mm"). Check your spam folder if you cannot find it.</div>
</div>

<form method="post" action="@Url.RouteUrl("password.otp.verify", new { guard })" id="otp-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="email" value="@email">
    <input type="hidden" name="otp" id="otp" value="@Flash.Old(ViewContext.HttpContext, "otp")">
    <label class="d-block mb-2" style="font-size:13px;font-weight:700;color:var(--w-green-700);" for="otp-0">Enter the 6-digit code</label>
    <div class="otp-boxes @(errors.Has("otp") || Flash.Get<string>(ViewContext.HttpContext, "reset_error") != null ? "otp-err" : "")">
        @{ string otpOld = Flash.Old(ViewContext.HttpContext, "otp") ?? ""; }
        @for (int i = 0; i < 6; i++)
        {
            string digit = i < otpOld.Length ? otpOld[i].ToString() : "";
            <input type="text" id="otp-@i" class="otp-box" inputmode="numeric" maxlength="1"
                   autocomplete="@(i == 0 ? "one-time-code" : "off")"
                   aria-label="Digit @(i + 1)" value="@digit" @(i == 0 ? "autofocus" : "")>
        }
    </div>
    @if (errors.Has("otp")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("otp")</div> }
    <div class="muted mt-2 mb-4" style="font-size:13.5px;">
        Did not get it?
        <button type="submit" form="resend-form" id="resend-btn" class="btn-link-w" @(resendIn > 0 ? "disabled" : "")>Resend code</button>
        <span id="resend-wait" @(resendIn <= 0 ? "class=\"d-none\"" : "")>in <span id="resend-timer">00:@resendIn.ToString().PadLeft(2, '0')</span></span>
    </div>
    <button type="submit" id="verify-btn" class="btn btn-w btn-lg-w btn-block">Verify code</button>
</form>

<form method="post" action="@Url.RouteUrl("password.forgot.submit", new { guard })" id="resend-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="email" value="@email">
</form>

@section scripts {
<script>
(function () {
    const boxes = Array.from(document.querySelectorAll('.otp-box'));
    const hidden = document.getElementById('otp');
    const sync = function () { hidden.value = boxes.map(function (b) { return b.value; }).join(''); };

    boxes.forEach(function (box, i) {
        box.addEventListener('input', function () {
            box.value = box.value.replace(/\D/g, '').slice(-1);
            sync();
            if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
        });
        box.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !box.value && i > 0) { boxes[i - 1].focus(); boxes[i - 1].value = ''; sync(); }
            if (e.key === 'ArrowLeft' && i > 0) boxes[i - 1].focus();
            if (e.key === 'ArrowRight' && i < boxes.length - 1) boxes[i + 1].focus();
        });
        box.addEventListener('paste', function (e) {
            const digits = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 6);
            if (!digits) return;
            e.preventDefault();
            digits.split('').forEach(function (d, k) { if (boxes[k]) boxes[k].value = d; });
            sync();
            boxes[Math.min(digits.length, 5)].focus();
        });
    });
    document.getElementById('otp-form').addEventListener('submit', sync);

    let left = @resendIn;
    const btn = document.getElementById('resend-btn');
    const wait = document.getElementById('resend-wait');
    const timer = document.getElementById('resend-timer');
    if (left > 0) {
        const t = setInterval(function () {
            left -= 1;
            timer.textContent = '00:' + String(Math.max(left, 0)).padStart(2, '0');
            if (left <= 0) { clearInterval(t); btn.disabled = false; wait.classList.add('d-none'); }
        }, 1000);
    }
})();
</script>
}
