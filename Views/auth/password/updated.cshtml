@{
    Layout = null;
    string loginRoute = ViewBag.LoginRoute ?? "login";
}
<!doctype html>
<html lang="en" dir="ltr">
<head>
@await Html.PartialAsync("~/Views/partials/_head.cshtml")
</head>
<body>
<div class="pw-done">
    <svg width="520" height="520" viewBox="0 0 520 520" fill="none" class="pw-done-blob-a" aria-hidden="true"><circle cx="260" cy="260" r="260" fill="#F4EDE6"/></svg>
    <svg width="420" height="420" viewBox="0 0 420 420" fill="none" class="pw-done-blob-b" aria-hidden="true"><circle cx="210" cy="210" r="210" fill="#F4EDE6"/></svg>

    <div style="position:relative;text-align:center;max-width:560px;">
        <svg width="150" height="150" viewBox="0 0 150 150" fill="none" style="display:block;margin:0 auto;" aria-hidden="true">
            <circle cx="75" cy="75" r="66" fill="#E8EDE9"/>
            <circle cx="75" cy="75" r="52" fill="#33463B"/>
            <path d="M54 76l14.5 14.5L97 62" stroke="#D8BD9E" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20 22l4 10.4 10.4 4-10.4 4L20 50.8l-4-10.4L5.6 36.4 16 32.4 20 22z" fill="#CAA380"/>
            <path d="M131 94l3.3 8.6 8.6 3.3-8.6 3.3-3.3 8.6-3.3-8.6-8.6-3.3 8.6-3.3 3.3-8.6z" fill="#CAA380"/>
            <path d="M126 32l2.6 6.8 6.8 2.6-6.8 2.6-2.6 6.8-2.6-6.8-6.8-2.6 6.8-2.6 2.6-6.8z" fill="#D8BD9E"/>
        </svg>
        <h1 class="h-sec mt-5" style="font-size:46px;">Your password is updated</h1>
        <p class="lead-w mt-3" style="max-width:460px;margin:0 auto;">You can now log in to Wijha with your new password.</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap mt-5">
            <a href="@Url.RouteUrl(loginRoute)" class="btn btn-w btn-lg-w">Log in now</a>
            <a href="@Url.RouteUrl("home")" class="btn btn-w-ghost btn-lg-w">Back to home</a>
        </div>
        <p class="muted mt-5 mb-0" style="font-size:14px;">Did not request this change? <a href="mailto:hello@wijha.sa" style="color:var(--w-green-700);font-weight:700;">Contact support</a></p>
    </div>
</div>
</body>
</html>
