@model dynamic
@{
    int step = Model?.step ?? 1;
    string[] labels = { "Event", "Booking details", "Review and pay" };
}
<div class="bk-stepper mb-4">
    @for (int i = 0; i < labels.Length; i++)
    {
        int n = i + 1;
        <div class="bk-step @(n == step ? "now" : "")">
            @if (n < step)
            {
                <span class="badge-w b-ok" style="width:30px;height:30px;justify-content:center;padding:0;"><i class="bi bi-check-lg"></i></span>
                <span class="bk-label" style="font-weight:700;color:var(--w-green-700);">@labels[i]</span>
            }
            else if (n == step)
            {
                <span class="badge-w" style="background:var(--w-green-700);color:#fff;width:30px;height:30px;justify-content:center;padding:0;">@n</span>
                <span class="bk-label" style="font-weight:700;color:var(--w-green-800);">@labels[i]</span>
            }
            else
            {
                <span class="badge-w b-grey" style="width:30px;height:30px;justify-content:center;padding:0;">@n</span>
                <span class="bk-label" style="color:var(--w-green-400);">@labels[i]</span>
            }
        </div>
        @if (n < labels.Length)
        {
            <div class="bk-bar" style="background:@(n < step ? "var(--w-green-700)" : "var(--w-line)");"></div>
        }
    }
</div>
