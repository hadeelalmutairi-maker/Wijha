@model dynamic
@{
    int seed = Model?.seed ?? 0;
    string height = Model?.height ?? "188px";
    string[] photos = { "camera", "stage", "table", "arch", "roses", "cake" };
    string photo = photos[Math.Abs(seed) % photos.Length];
}
<div class="ph" style="height: @height; position:relative; overflow:hidden;">
    <img src="/images/theme/@(photo).jpg" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
</div>
