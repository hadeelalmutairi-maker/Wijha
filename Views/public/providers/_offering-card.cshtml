@using Wijha.Models
@using Wijha.Helpers
@{
    var ps = (ProviderService)ViewContext.ViewData["ps"]!;
    string layout = ViewContext.ViewData["layout"] as string ?? "stack";
    DateOnly? dateFilter = ViewContext.ViewData["date"] as DateOnly?;
    var nextFree = ViewContext.ViewData["nextFree"] as Dictionary<int, DateOnly?>;
    bool isRow = layout == "row";
    string? imgUrl = WijhaHelpers.ImageUrl(ps.PortfolioUrl ?? ps.ServiceProvider?.LogoUrl);
    DateOnly? nextDate = nextFree?.GetValueOrDefault(ps.ProviderServiceId);
    bool matchesDate = dateFilter.HasValue && nextDate == dateFilter;
    bool hasNext = nextDate.HasValue;
}
<a href="@Url.RouteUrl("providers.show", new { id = ps.ProviderId, service_id = ps.ProviderServiceId })"
   class="card-w card-sig offering-card @(isRow ? "offering-row" : "offering-stack") text-decoration-none">
    <div class="offering-img @(isRow ? "offering-img-row" : "offering-img-stack")">
        @if (imgUrl != null)
        {
            <img src="@imgUrl" alt="@ps.OfferingTitle" style="width:100%;height:100%;object-fit:cover;display:block;">
        }
        else
        {
            @await Html.PartialAsync("~/Views/components/_decor-photo.cshtml", (object)new { seed = ps.ProviderServiceId, height = "100%" })
        }
        @if (matchesDate)
        {
            <span class="avail-badge b-ok"><i class="bi bi-check-circle-fill"></i> Free on that date</span>
        }
        else if (hasNext)
        {
            <span class="avail-badge b-grey"><i class="bi bi-calendar3"></i> @nextDate!.Value.ToString("dd MMM")</span>
        }
        else
        {
            <span class="avail-badge b-warn"><i class="bi bi-calendar-x"></i> No open dates</span>
        }
    </div>
    <div class="offering-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div style="min-width:0;">
                <h3 class="h-card mb-0 clamp-1">@ps.OfferingTitle</h3>
                <div class="muted mt-1" style="font-size:13px;">@ps.ServiceProvider?.BusinessName &middot; @ps.ServiceCity</div>
            </div>
            <span class="rate flex-shrink-0"><i class="bi bi-star-fill"></i>@(ps.ServiceProvider?.AverageRating.ToString("F1") ?? "–")</span>
        </div>
        @if (!string.IsNullOrEmpty(ps.OfferingDescription))
        {
            <p class="muted mt-2 mb-0 clamp-2" style="font-size:14px;line-height:1.6;">@ps.OfferingDescription</p>
        }
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
            <div>
                <span class="price" style="font-size:19px;">SAR @ps.Price.ToString("N0")</span>
                <span class="muted" style="font-size:13px;"> @WijhaHelpers.PriceUnit(ps.PriceUnit)</span>
            </div>
            <span class="badge-w b-cream" style="font-size:12px;">@ps.Service?.ServiceName</span>
        </div>
    </div>
</a>
