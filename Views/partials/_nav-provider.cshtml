@using Wijha.Support.Auth
@using Wijha.Support.Helpers
@{
    var provider = Auth.Guard(ViewContext.HttpContext, "provider").User<Wijha.Models.ServiceProvider>()!;
    var dbContext = ViewContext.HttpContext.RequestServices.GetRequiredService<Wijha.Data.AppDbContext>();
    var pendingRequests = dbContext.Bookings.Count(b => b.ProviderService.ProviderId == provider.ProviderId && b.BookingStatus == "Pending");
    var unreadCount = dbContext.Messages.Count(m => m.ProviderId == provider.ProviderId && m.SenderType == "Customer" && !m.IsRead);
}
<nav class="nav-w">
    <a href="@Url.RouteUrl("provider.dashboard")" class="logo-row">
        @await Html.PartialAsync("~/Views/components/_logo.cshtml", new { dark = true, size = 58 })
        <div>
            <div class="logo-txt">Wijha</div>
            <div class="logo-sub">Provider Dashboard</div>
        </div>
    </a>
    <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#nav-menu-provider" aria-controls="nav-menu-provider" aria-expanded="false" aria-label="Menu">
        <i class="bi bi-list"></i>
    </button>
    <div class="nav-collapse collapse" id="nav-menu-provider">
        <div class="nav-links">
            <a href="@Url.RouteUrl("provider.bookings.index")">Requests</a>
            <a href="@Url.RouteUrl("provider.bookings.confirmed")">Bookings</a>
            <a href="@Url.RouteUrl("provider.services.index")">My Services</a>
            <a href="@Url.RouteUrl("provider.availability.index")">Availability</a>
            <a href="@Url.RouteUrl("provider.messages.index")" style="display:inline-flex;align-items:center;gap:6px;">
                Messages
                @if (unreadCount > 0) { <span class="badge-w b-gold" style="padding:1px 8px;font-size:11.5px;">@unreadCount</span> }
            </a>
            <div class="dropdown nav-more">
                <button type="button" class="nav-more-btn" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                    More <i class="bi bi-chevron-down"></i></button>
                <ul class="dropdown-menu dropdown-menu-end nav-more-menu">
                    <li><a class="dropdown-item" href="@Url.RouteUrl("provider.reviews.index")"><i class="bi bi-star"></i> Reviews</a></li>
                    <li><a class="dropdown-item" href="@Url.RouteUrl("provider.categories.index")"><i class="bi bi-folder2"></i> Store categories</a></li>
                    @if (provider.IsApproved())
                    {
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#store-preview-modal"><i class="bi bi-shop"></i> Store page preview</a></li>
                    }
                    <li><a class="dropdown-item" href="@Url.RouteUrl("provider.profile.edit")"><i class="bi bi-person-gear"></i> Business profile</a></li>
                </ul>
            </div>
        </div>
        <div class="nav-actions">
            @if (pendingRequests > 0)
            {
                <a href="@Url.RouteUrl("provider.bookings.index", new { status = "Pending" })" class="badge-w b-warn text-decoration-none" title="Requests awaiting your reply"><i class="bi bi-bell-fill"></i> @pendingRequests new</a>
            }
            else
            {
                <span class="nav-icon-link" title="No new requests"><i class="bi bi-bell"></i></span>
            }
            <a href="@Url.RouteUrl("provider.dashboard")" class="nav-icon-link" title="Dashboard"><i class="bi bi-grid"></i><span class="d-lg-none ms-2">Dashboard</span></a>
            <a href="@Url.RouteUrl("provider.profile.edit")" class="d-flex align-items-center gap-2 text-decoration-none" title="Business profile">
                @await Html.PartialAsync("~/Views/components/_avatar.cshtml", new { url = WijhaHelpers.ImageUrl(provider.LogoUrl), initials = provider.BusinessName.Substring(0, Math.Min(2, provider.BusinessName.Length)).ToUpperInvariant() })
                <span class="muted d-lg-none d-xl-inline" style="font-size:14px;">@provider.BusinessName</span>
            </a>
            <form method="post" action="@Url.RouteUrl("provider.logout")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-w-ghost btn-sm-w" aria-label="Log out" title="Log out"><i class="bi bi-box-arrow-right nav-logout-ico"></i><span class="nav-logout-txt">Log out</span></button>
            </form>
        </div>
    </div>
</nav>

@if (provider.IsApproved())
{
    <div class="modal fade" id="store-preview-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable" style="max-width:1100px;">
            <div class="modal-content" style="border-radius:var(--r-xl);border:0;height:88vh;">
                <div class="d-flex justify-content-between align-items-center" style="padding:18px 24px;border-bottom:1px solid rgba(200,209,204,.6);">
                    <div>
                        <h2 class="h-sec mb-0">Store page preview</h2>
                        <p class="muted mb-0" style="font-size:13px;">This is a read-only preview. Links and buttons inside it are disabled.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding:0;overflow-y:auto;background:var(--w-cream-200);">
                    <iframe id="store-preview-frame" data-src="@Url.RouteUrl("providers.show", new { provider = provider.ProviderId })" style="width:100%;border:0;display:block;pointer-events:none;" title="Store page preview"></iframe>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            const modalEl = document.getElementById('store-preview-modal');
            const frame = document.getElementById('store-preview-frame');
            if (!modalEl || !frame) return;
            modalEl.addEventListener('show.bs.modal', function () {
                if (!frame.src) frame.src = frame.dataset.src;
            });
            frame.addEventListener('load', function () {
                try { frame.style.height = frame.contentWindow.document.documentElement.scrollHeight + 'px'; }
                catch (e) { frame.style.height = '2200px'; }
            });
        })();
    </script>
}
