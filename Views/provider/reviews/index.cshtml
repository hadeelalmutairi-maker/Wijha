@using Wijha.Models
@using Wijha.Support
@{
    Layout = "~/Views/layouts/_provider.cshtml";
    ViewBag.Title = "Reviews | Wijha";
    var reviews = (LengthAwarePaginator<Review>)ViewBag.Reviews;
    var totals = (Dictionary<string, object>)ViewBag.Totals;
    string? q = ViewBag.Q as string;
    string? ratingFilter = ViewBag.Rating as string;
}
<div class="page-pad">
    @await Html.PartialAsync("~/Views/partials/_flash.cshtml")
    <h1 class="h-pg mb-4">Reviews received</h1>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="kpi">
            <div class="lbl">Total reviews</div><div class="n mt-2">@totals["count"]</div>
        </div></div>
        <div class="col-6 col-md-3"><div class="kpi">
            <div class="lbl">Average rating</div>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <div class="n">@(((decimal)totals["average"]).ToString("F1"))</div>
                <i class="bi bi-star-fill" style="color:var(--w-sand-400);font-size:18px;"></i>
            </div>
        </div></div>
        <div class="col-md-6"><div class="kpi">
            <div class="lbl mb-2">Breakdown</div>
            @{
                var breakdown = (Dictionary<int, int>)totals["breakdown"];
                int totalCount = (int)totals["count"];
            }
            @for (int r = 5; r >= 1; r--)
            {
                int cnt = breakdown.ContainsKey(r) ? breakdown[r] : 0;
                int pct = totalCount > 0 ? (int)Math.Round((double)cnt / totalCount * 100) : 0;
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span style="font-size:12.5px;width:10px;">@r</span>
                    <span class="rbar" style="flex:1;"><i style="width:@pct%"></i></span>
                    <span class="muted" style="font-size:12px;width:22px;text-align:right;">@cnt</span>
                </div>
            }
        </div></div>
    </div>

    <form method="get" action="@Url.RouteUrl("provider.reviews.index")" class="d-flex gap-2 flex-wrap mb-4">
        <div class="inp-icon" style="flex:1;min-width:220px;max-width:360px;"><i class="bi bi-search"></i>
            <input type="text" name="q" class="inp" value="@q" placeholder="Search review text or customer name"></div>
        <select name="rating" class="inp" style="max-width:150px;" onchange="this.form.submit()">
            <option value="">All ratings</option>
            @for (int r = 5; r >= 1; r--)
            {
                <option value="@r" @(ratingFilter == r.ToString() ? "selected" : "")>@r star@(r == 1 ? "" : "s")</option>
            }
        </select>
        <button type="submit" class="btn btn-w-ghost">Filter</button>
        @if (!string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(ratingFilter))
        {
            <a href="@Url.RouteUrl("provider.reviews.index")" class="btn btn-w-ghost">Clear</a>
        }
    </form>

    @if (reviews.Items.Any())
    {
        @foreach (var review in reviews.Items)
        {
            <div class="card-w mb-3" style="padding:22px;">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div class="d-flex gap-3">
                        <div class="av">@(review.Booking?.Customer?.FirstName?[0].ToString().ToUpper())</div>
                        <div>
                            <div style="font-weight:700;font-size:15px;">@review.Booking?.Customer?.FirstName @review.Booking?.Customer?.LastName</div>
                            <div class="muted" style="font-size:13px;">@review.Booking?.ProviderService?.OfferingTitle &middot; @review.ReviewDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <span style="color:var(--w-sand-400);letter-spacing:2px;">
                        @for (int i = 0; i < 5; i++) { <i class="bi bi-star@(i < review.Rating ? "-fill" : "")"></i> }
                    </span>
                </div>
                @if (review.ReviewText != null)
                {
                    <p class="mt-3 mb-0" style="font-size:14.5px;line-height:1.6;color:var(--w-green-700);">@review.ReviewText</p>
                }
            </div>
        }
    }
    else
    {
        <div class="card-w text-center" style="padding:60px;">
            <p class="muted mb-0">No reviews match your search.</p>
        </div>
    }

    <div class="mt-4">@Html.Raw(reviews.Links())</div>
</div>
