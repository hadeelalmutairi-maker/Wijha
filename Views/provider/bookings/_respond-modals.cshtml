@using Wijha.Models
@using Wijha.Support.Http
@model Booking
@{
    var errors = new ErrorBag(ViewContext);
    string time = Model.ServiceTime.ToString("HH:mm");
    var reasons = new Dictionary<string, string>
    {
        ["I am not available on that date"] = $"{Model.ServiceDate.ToString("dd MMM yyyy")} is not open on your schedule.",
        ["I cannot meet the requirements"] = "Crew, equipment or location is outside what you offer.",
        ["The venue is too far"] = "Outside the city you serve.",
    };
}

<div class="modal fade" id="accept-@Model.BookingId" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="border-radius:var(--r-xl);border:0;">
        <form method="post" action="@Url.RouteUrl("provider.bookings.respond", new { id = Model.BookingId })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="action" value="accept">
            <div class="text-center" style="padding:32px 30px 0;">
                <svg width="72" height="72" viewBox="0 0 76 76" fill="none" style="margin:0 auto;display:block;">
                    <circle cx="38" cy="38" r="34" fill="#E8EDE9"/><circle cx="38" cy="38" r="25" fill="#33463B"/>
                    <path d="M28 38.5l7 7 13-14" stroke="#D8BD9E" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <h2 class="h-sec mt-3">Accept this booking?</h2>
                <p class="muted mt-2 mb-0" style="font-size:14.5px;line-height:1.6;">@Model.Customer?.FirstName @Model.Customer?.LastName will be asked to pay SAR @Model.AgreedPrice.ToString("N0") and the date will be reserved on your schedule.</p>
            </div>
            <div class="modal-body" style="padding:22px 30px;">
                <div style="background:var(--w-cream-200);border-radius:var(--r-md);padding:16px 20px;">
                    <div class="sum-row"><span class="k">Service</span><span class="v text-end">@Model.ProviderService?.OfferingTitle</span></div>
                    <div class="sum-row"><span class="k">Date and time</span><span class="v">@Model.ServiceDate.ToString("dd MMM yyyy") &middot; @time</span></div>
                    <div class="sum-row"><span class="k">Venue</span><span class="v text-end">@(Model.VenueAddress?.Length > 34 ? Model.VenueAddress.Substring(0, 34) + "…" : Model.VenueAddress)</span></div>
                    <div class="sum-row"><span class="k">Agreed price</span><span class="v">SAR @Model.AgreedPrice.ToString("N2")</span></div>
                </div>
                @if (Model.SpecialRequirements != null)
                {
                    <label style="font-size:13.5px;color:var(--w-green-600);display:flex;align-items:start;gap:10px;margin-top:16px;line-height:1.55;cursor:pointer;">
                        <input type="checkbox" required style="margin-top:3px;flex:none;">
                        I have read the special requirements and can meet them.
                    </label>
                }
                <div class="field mt-3" style="margin-bottom:0;">
                    <label>Message to the customer (optional)</label>
                    <textarea name="message_text" class="inp inp-area" rows="2" maxlength="1000" style="min-height:70px;" placeholder="Looking forward to it!"></textarea>
                </div>
            </div>
            <div class="modal-foot d-flex gap-2">
                <button type="button" class="btn btn-w-ghost flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-w flex-grow-1">Yes, accept booking</button>
            </div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="reject-@Model.BookingId" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" style="border-radius:var(--r-xl);border:0;">
        <form method="post" action="@Url.RouteUrl("provider.bookings.respond", new { id = Model.BookingId })" class="reject-form" style="display:flex;flex-direction:column;max-height:88vh;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="action" value="reject">
            <div style="padding:26px 30px 0;">
                <div class="d-flex justify-content-between align-items-start">
                    <div><div class="lbl">Request @Model.Reference</div>
                        <h2 class="h-sec mt-2 mb-0">Reject this booking?</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <p class="muted mt-2 mb-0" style="font-size:14.5px;line-height:1.6;">@Model.Customer?.FirstName will see the reason you give. A clear reason helps them find another provider quickly.</p>
            </div>
            <div class="modal-body" style="padding:20px 30px;overflow-y:auto;">
                @{ bool reasonErr = errors.Has("rejection_reason"); }
                @if (reasonErr)
                {
                    <div class="alert-w a-err mb-4">
                        <i class="bi bi-exclamation-circle-fill" style="font-size:18px;"></i>
                        <div><strong>A reason is required.</strong><br>Wijha stores the rejection reason on the booking so the customer and the administrator can see why.</div>
                    </div>
                }
                <div class="lbl mb-3" @(reasonErr ? "style=\"color:var(--w-danger);\"" : "")>Reason <span style="color:var(--w-danger);">*</span></div>
                @{ bool isFirst = true; }
                @foreach (var kv in reasons)
                {
                    bool pre = !reasonErr && isFirst;
                    isFirst = false;
                    <label class="opt reason-opt @(pre ? "on" : "") @(reasonErr ? "opt-err" : "")" style="cursor:pointer;">
                        <input type="radio" name="rejection_reason" value="@kv.Key" class="d-none" @(pre ? "checked" : "")>
                        <span class="radio @(pre ? "on" : "")"></span>
                        <div class="flex-grow-1"><div style="font-weight:700;font-size:15px;">@kv.Key</div>
                            <div class="muted mt-1" style="font-size:13.5px;">@kv.Value</div></div>
                    </label>
                }
                <label class="opt reason-opt @(reasonErr ? "opt-err" : "")" style="cursor:pointer;margin-bottom:12px;">
                    <input type="radio" name="rejection_reason" value="__other" class="d-none">
                    <span class="radio"></span>
                    <div class="flex-grow-1"><div style="font-weight:700;font-size:15px;">Another reason</div></div>
                </label>
                <div class="field other-reason d-none">
                    <input type="text" name="rejection_reason_other" class="inp" maxlength="500" placeholder="Write the reason the customer will see">
                </div>
                @if (reasonErr)
                {
                    <div class="help-err mb-3" style="margin-top:-4px;"><i class="bi bi-exclamation-circle"></i> Select one reason, or write your own, before rejecting.</div>
                }
                <div class="field" style="margin-bottom:0;">
                    <label>Message to the customer (optional)</label>
                    <textarea name="message_text" class="inp inp-area" rows="3" maxlength="1000" placeholder="e.g. I have free slots on other dates if either works for you.">@(Flash.Old(ViewContext.HttpContext, "action") == "reject" ? Flash.Old(ViewContext.HttpContext, "message_text") : "")</textarea>
                </div>
            </div>
            <div class="modal-foot d-flex gap-2">
                <button type="button" class="btn btn-w-ghost flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-w-danger-fill flex-grow-1">Reject request</button>
            </div>
        </form>
    </div></div>
</div>
