@using Wijha.Models
@using Wijha.Support.Http
@model Booking
@{
    Layout = "~/Views/layouts/_customer.cshtml";
    ViewBag.Title = "Payment | Wijha";
    var ps = Model.ProviderService!;
    var provider = ps.ServiceProvider!;
    var customer = (Customer)ViewBag.CurrentCustomer;
    var errors = new ErrorBag(ViewContext);
    var methods = new Dictionary<string,(string icon, bool card, string note)>
    {
        ["Credit Card"] = ("bi-credit-card", true, "Visa, Mastercard and other cards"),
        ["Apple Pay"]   = ("bi-apple", false, "Pay with Face ID or Touch ID"),
    };
    string selected = Flash.Old(ViewContext.HttpContext, "payment_method") ?? "Credit Card";
    if (!methods.ContainsKey(selected)) selected = "Credit Card";
    bool isCard = methods[selected].card;
    var cardFields = new[] { "card_name", "card_number", "card_exp", "card_cvv" };
    bool cardErrors = cardFields.Any(f => errors.Has(f));
}
<div class="crumbs crumbs-c"><a href="@Url.RouteUrl("customer.bookings.index")">My bookings</a> <i class="bi bi-chevron-right" style="font-size:10px;"></i> <span class="cur">Payment</span></div>

<div class="page-wrap" id="payment-page">
    <div class="alert-w a-ok mb-4">
        <i class="bi bi-check-circle-fill" style="font-size:18px;"></i>
        <div><strong>@provider.BusinessName accepted your booking @Model.Reference.</strong><br>Complete the payment to confirm the date.</div>
    </div>
    <h1 class="h-pg">Payment</h1>
    <p class="muted mt-2 mb-4" style="font-size:15px;">One booking is paid by a single payment. An invoice is issued the moment it succeeds.</p>

    @await Html.PartialAsync("~/Views/partials/_flash.cshtml")
    @if (cardErrors)
    {
        <div class="alert-w a-err mb-4">
            <i class="bi bi-exclamation-circle-fill" style="font-size:18px;"></i>
            <div><strong>The payment was not taken.</strong><br>Check the card details below. Nothing was charged.</div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <form method="post" action="@Url.RouteUrl("customer.payments.store", new { id = Model.BookingId })" id="payment-form" class="card-w" style="padding:30px;" novalidate>
                @Html.AntiForgeryToken()
                <h2 class="h-sec mb-3">Payment method</h2>
                <div class="row g-3 mb-2">
                    @foreach (var kv in methods)
                    {
                        string method = kv.Key;
                        var meta = kv.Value;
                        bool isSel = selected == method;
                        <div class="col-sm-6">
                            <label class="opt pay-opt @(isSel ? "on" : "")" style="margin:0;flex-direction:column;gap:10px;cursor:pointer;height:100%;" data-card="@(meta.card ? "1" : "0")">
                                <input type="radio" name="payment_method" value="@method" class="d-none" @(isSel ? "checked" : "") required>
                                <div class="d-flex justify-content-between w-100 align-items-center">
                                    <i class="bi @meta.icon" style="font-size:22px;color:var(--w-green-700);"></i>
                                    <span class="radio @(isSel ? "on" : "")" style="margin:0;"></span>
                                </div>
                                <div>
                                    <div style="font-weight:700;font-size:15px;">@method</div>
                                    <div class="muted" style="font-size:13px;">@meta.note</div>
                                </div>
                            </label>
                        </div>
                    }
                </div>
                @if (errors.Has("payment_method")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("payment_method")</div> }

                <div id="card-fields" class="@(!isCard ? "d-none" : "")">
                    <hr class="divider my-4">
                    <div class="field">
                        <label for="card_name">Name on card <span style="color:var(--w-danger);">*</span></label>
                        <input id="card_name" name="card_name" class="inp card-in @(errors.Has("card_name") ? "inp-err" : "")" autocomplete="cc-name" maxlength="100"
                               value="@Flash.Old(ViewContext.HttpContext, "card_name")" placeholder="@($"{customer.FirstName} {customer.LastName}".ToUpper())" @(!isCard ? "disabled" : "")>
                        <div class="help-err @(errors.Has("card_name") ? "" : "d-none")" data-err="card_name"><i class="bi bi-exclamation-circle"></i> <span>@errors.First("card_name")</span></div>
                    </div>
                    <div class="field">
                        <label for="card_number">Card number <span style="color:var(--w-danger);">*</span></label>
                        <div class="inp-icon"><i class="bi bi-credit-card-2-front"></i>
                            <input id="card_number" name="card_number" class="inp card-in @(errors.Has("card_number") ? "inp-err" : "")" autocomplete="cc-number" inputmode="numeric"
                                   maxlength="19" placeholder="0000 0000 0000 0000" @(!isCard ? "disabled" : "")></div>
                        <div class="help-err @(errors.Has("card_number") ? "" : "d-none")" data-err="card_number"><i class="bi bi-exclamation-circle"></i> <span>@errors.First("card_number")</span></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6"><div class="field">
                            <label for="card_exp">Expiry <span style="color:var(--w-danger);">*</span></label>
                            <input id="card_exp" name="card_exp" class="inp card-in @(errors.Has("card_exp") ? "inp-err" : "")" autocomplete="cc-exp" inputmode="numeric" maxlength="7"
                                   value="@Flash.Old(ViewContext.HttpContext, "card_exp")" placeholder="MM / YY" @(!isCard ? "disabled" : "")>
                            <div class="help-err @(errors.Has("card_exp") ? "" : "d-none")" data-err="card_exp"><i class="bi bi-exclamation-circle"></i> <span>@errors.First("card_exp")</span></div>
                        </div></div>
                        <div class="col-6"><div class="field">
                            <label for="card_cvv">CVV <span style="color:var(--w-danger);">*</span></label>
                            <div class="inp-icon"><i class="bi bi-shield-lock"></i>
                                <input id="card_cvv" name="card_cvv" type="password" class="inp card-in @(errors.Has("card_cvv") ? "inp-err" : "")" autocomplete="cc-csc" inputmode="numeric"
                                       maxlength="3" placeholder="&bull;&bull;&bull;" @(!isCard ? "disabled" : "")></div>
                            <div class="help-err @(errors.Has("card_cvv") ? "" : "d-none")" data-err="card_cvv"><i class="bi bi-exclamation-circle"></i> <span>@errors.First("card_cvv")</span></div>
                        </div></div>
                    </div>
                </div>

                <div id="apple-pay-note" class="@(isCard ? "d-none" : "")">
                    <hr class="divider my-4">
                    <p class="muted mb-0" style="font-size:14.5px;"><i class="bi bi-apple me-1"></i> You will confirm the payment with Apple Pay on your device after pressing Pay.</p>
                </div>

                <div class="alert-w a-info mt-4" style="font-size:13.5px;">
                    <i class="bi bi-shield-check" style="font-size:16px;"></i>
                    <div>Simulated checkout for this project. Card details are only checked for the right number of digits and a valid expiry date. They are never stored, and nothing is charged.</div>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="card-w" style="padding:26px;">
                <div class="lbl mb-3">You are paying for</div>
                <div style="font-weight:700;font-size:15.5px;line-height:1.35;">@ps.OfferingTitle</div>
                <div class="muted mb-3" style="font-size:13.5px;">@provider.BusinessName &middot; @Model.ServiceDate.ToString("dd MMM yyyy") &middot; @Model.ServiceTime.ToString("HH:mm")</div>
                <hr class="divider my-3">
                <div class="sum-row"><span class="k">Booking reference</span><span class="v">@Model.Reference</span></div>
                <div class="sum-row"><span class="k">Booking status</span><span class="badge-w b-ok">Accepted</span></div>
                @if (Model.MyEvent != null)
                {
                    <div class="sum-row"><span class="k">Event</span><span class="v">@Model.MyEvent.EventName</span></div>
                }
                <hr class="divider my-3">
                <div class="sum-row"><span class="k">Service price</span><span class="v">SAR @Model.AgreedPrice.ToString("N2")</span></div>
                <div class="sum-row"><span class="k">Platform fee</span><span class="v">SAR 0.00</span></div>
                <div class="sum-row"><span class="k">VAT (15%)</span><span class="v">Included</span></div>
                <hr class="divider my-3">
                <div class="sum-row"><span class="k" style="font-size:16px;">Amount due</span><span class="price" style="font-size:26px;">SAR @Model.AgreedPrice.ToString("N0")</span></div>
                <button type="submit" form="payment-form" class="btn btn-w btn-block btn-lg-w mt-3"><i class="bi bi-lock-fill me-2"></i>Pay SAR @Model.AgreedPrice.ToString("N0")</button>
                <p class="muted text-center mt-3 mb-0" style="font-size:13px;">Refundable under the cancellation policy.</p>
            </div>
        </div>
    </div>
</div>

<div id="processing-screen" class="d-none" style="padding:90px 24px 120px;text-align:center;">
    <svg width="104" height="104" viewBox="0 0 104 104" fill="none" style="margin:0 auto;display:block;animation:wspin 1.1s linear infinite;">
        <circle cx="52" cy="52" r="42" stroke="#E3DED6" stroke-width="9"/>
        <path d="M52 10a42 42 0 0 1 36 21" stroke="#33463B" stroke-width="9" stroke-linecap="round"/>
    </svg>
    <h1 class="h-pg mt-5">Processing your payment</h1>
    <p class="lead-w mt-3" style="max-width:460px;margin:0 auto;">We are confirming the transaction with your bank. This usually takes a few seconds.</p>
    <div class="card-w mt-5" style="max-width:460px;margin:0 auto;padding:22px 26px;text-align:left;">
        <div class="sum-row"><span class="k">Booking reference</span><span class="v">@Model.Reference</span></div>
        <div class="sum-row"><span class="k">Amount</span><span class="v">SAR @Model.AgreedPrice.ToString("N2")</span></div>
        <div class="sum-row"><span class="k">Method</span><span class="v" id="processing-method">@selected</span></div>
        <div class="sum-row"><span class="k">Payment status</span><span class="badge-w b-warn">Pending</span></div>
    </div>
    <div class="alert-w a-info mt-4" style="max-width:460px;margin:0 auto;text-align:left;">
        <i class="bi bi-exclamation-triangle-fill" style="font-size:17px;"></i>
        <div>Please do not close this page or press back until the payment finishes.</div>
    </div>
</div>

<style>@@keyframes wspin{to{transform:rotate(360deg);}}</style>

@section scripts {
<script>
(function () {
    const form = document.getElementById('payment-form');
    const cardFields = document.getElementById('card-fields');
    const appleNote = document.getElementById('apple-pay-note');
    const cardInputs = cardFields.querySelectorAll('.card-in');
    const $ = function (id) { return document.getElementById(id); };
    const digits = function (v) { return (v || '').replace(/\D/g, ''); };
    const isCard = function () { const c = form.querySelector('input[name="payment_method"]:checked'); return c && c.closest('.pay-opt').dataset.card === '1'; };
    const method = function () { const c = form.querySelector('input[name="payment_method"]:checked'); return c ? c.value : ''; };

    const checks = {
        card_name: function (v) { if (!v.trim()) return 'Enter the name on the card.'; },
        card_number: function (v) {
            const n = digits(v);
            if (!n) return 'Enter your card number.';
            if (n.length !== 16) return 'The card number must be 16 digits.';
        },
        card_exp: function (v) {
            if (!v.trim()) return 'Enter the expiry date.';
            const m = v.replace(/\s/g, '').match(/^(0[1-9]|1[0-2])\/(\d{2})$/);
            if (!m) return 'Use the format MM / YY.';
            if (new Date(2000 + +m[2], +m[1], 0, 23, 59, 59) < new Date()) return 'This card has expired.';
        },
        card_cvv: function (v) {
            if (!v.trim()) return 'Enter the 3-digit CVV.';
            if (!/^\d{3}$/.test(v.trim())) return 'The CVV must be 3 digits.';
        },
    };

    function show(field, msg) {
        const input = $(field), box = form.querySelector('[data-err="' + field + '"]');
        input.classList.toggle('inp-err', !!msg);
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
        box.querySelector('span').textContent = msg || '';
        box.classList.toggle('d-none', !msg);
    }
    function validate(field) { const msg = checks[field]($(field).value); show(field, msg); return !msg; }

    $('card_number').addEventListener('input', function () {
        this.value = digits(this.value).slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1 ');
    });
    $('card_exp').addEventListener('input', function (e) {
        let n = digits(this.value).slice(0, 4);
        if (n.length === 1 && +n > 1) n = '0' + n;
        this.value = n.length > 2 ? n.slice(0, 2) + ' / ' + n.slice(2) : (n.length === 2 && e.inputType !== 'deleteContentBackward' ? n + ' / ' : n);
    });
    $('card_cvv').addEventListener('input', function () { this.value = digits(this.value).slice(0, 3); });

    Object.keys(checks).forEach(function (f) {
        $(f).addEventListener('blur', function () { if ($(f).value) validate(f); });
        $(f).addEventListener('input', function () { if ($(f).classList.contains('inp-err')) validate(f); });
    });

    document.querySelectorAll('.pay-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
            document.querySelectorAll('.pay-opt').forEach(function (o) {
                o.classList.remove('on'); o.querySelector('.radio').classList.remove('on');
            });
            opt.classList.add('on'); opt.querySelector('.radio').classList.add('on');
            opt.querySelector('input').checked = true;
            const card = opt.dataset.card === '1';
            cardFields.classList.toggle('d-none', !card);
            appleNote.classList.toggle('d-none', card);
            cardInputs.forEach(function (i) { i.disabled = !card; });
        });
    });

    let submitting = false;
    form.addEventListener('submit', function (e) {
        if (submitting) return;
        e.preventDefault();
        if (isCard()) {
            const bad = Object.keys(checks).filter(function (f) { return !validate(f); });
            if (bad.length) { $(bad[0]).focus(); return; }
        }
        submitting = true;
        document.getElementById('processing-method').textContent = method();
        document.getElementById('payment-page').classList.add('d-none');
        document.querySelector('.crumbs').classList.add('d-none');
        document.getElementById('processing-screen').classList.remove('d-none');
        window.scrollTo(0, 0);
        setTimeout(function () { form.submit(); }, 1600);
    });
})();
</script>
}
