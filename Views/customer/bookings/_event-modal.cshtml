@using Wijha.Models
@using Wijha.Support.Http
@{
    var providerService = (ProviderService)ViewBag.ProviderService;
    string? selectedDate = ViewBag.SelectedDate;
    string? selectedTime = ViewBag.SelectedTime;
    var myEvents = (IEnumerable<CustomerEvent>)ViewBag.MyEvents;
    decimal price = providerService.Price;
    var eventTypes = new[] { "Wedding", "Engagement", "Graduation", "Birthday", "Baby Shower", "Corporate", "National Day", "Other" };
    bool reopenCreate = Flash.Old(ViewContext.HttpContext, "continue_service") != null;
    var errors = new ErrorBag(ViewContext);
    var detailsBase = new { provider_service_id = providerService.ProviderServiceId, date = selectedDate, time = selectedTime };
}
<div class="modal fade" id="event-modal" tabindex="-1" aria-labelledby="event-modal-title" data-open-create="@(reopenCreate ? "1" : "0")">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:620px;">
        <div class="modal-content" style="border-radius:var(--r-xl);border:0;">

            <div id="pane-choose" @(reopenCreate ? "class=\"d-none\"" : "")>
                <div class="modal-head modal-photo-head d-flex justify-content-between align-items-start">
                    <div>
                        <div class="lbl">Step 1 of 3</div>
                        <h2 class="h-sec mt-1 mb-0" id="event-modal-title">Is this part of an event?</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="muted mb-4" style="font-size:14.5px;">Grouping bookings under an event lets Wijha track them against one budget. It is optional.</p>
                    @{ int evIdx = 0; }
                    @foreach (var ev in myEvents)
                    {
                        decimal spent = ev.Bookings?.Sum(b => b.AgreedPrice) ?? 0m;
                        decimal after = spent + price;
                        decimal budget = ev.TotalBudget ?? 0m;
                        int count = ev.Bookings?.Count ?? 0;
                        bool first = evIdx == 0;
                        string detailsHref = Url.RouteUrl("customer.bookings.details", new { provider_service_id = providerService.ProviderServiceId, date = selectedDate, time = selectedTime, my_event_id = ev.MyEventId }) ?? "#";
                        <label class="opt ev-opt @(first ? "on" : "")" data-href="@detailsHref">
                            <input type="radio" name="ev_choice" class="d-none" @(first ? "checked" : "")>
                            <span class="radio @(first ? "on" : "")"></span>
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div style="font-weight:700;font-size:15.5px;color:var(--w-green-800);">@ev.EventName</div>
                                    <span class="badge-w b-warn flex-none">@ev.EventStatus</span>
                                </div>
                                <div class="muted mt-1" style="font-size:13.5px;">@ev.EventType &middot; @ev.EventDate.ToString("d MMM yyyy") &middot; @count booking@(count == 1 ? "" : "s") already added</div>
                                @if (budget > 0)
                                {
                                    double spentPct = (double)(spent / budget * 100);
                                    double addPct = (double)(Math.Max(0, Math.Min(100, after / budget * 100) - Math.Min(100, spent / budget * 100)));
                                    <div class="ev-budget mt-3">
                                        <div class="d-flex justify-content-between gap-2 flex-wrap">
                                            <span class="lbl">Budget after this booking</span>
                                            <span style="font-size:13px;font-weight:700;color:@(after > budget ? "var(--w-danger)" : "var(--w-green-800)");">SAR @after.ToString("N0") of @budget.ToString("N0")</span>
                                        </div>
                                        <div class="ev-bar mt-2">
                                            <span style="width:@Math.Min(100, spentPct).ToString("F0")%;background:var(--w-green-600);"></span>
                                            <span style="width:@addPct.ToString("F0")%;background:var(--w-sand-400);"></span>
                                        </div>
                                        <div class="muted mt-1" style="font-size:12.5px;">
                                            <i class="bi bi-square-fill" style="font-size:8px;color:var(--w-sand-400);"></i> SAR @price.ToString("N0") this booking &middot;
                                            @if (after > budget)
                                            {
                                                <span style="color:var(--w-danger);font-weight:700;">SAR @((after - budget).ToString("N0")) over budget</span>
                                            }
                                            else
                                            {
                                                <text>SAR @((budget - after).ToString("N0")) left</text>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </label>
                        evIdx++;
                    }
                    <label class="opt ev-opt @(!myEvents.Any() ? "on" : "")" data-pane="create">
                        <input type="radio" name="ev_choice" class="d-none" @(!myEvents.Any() ? "checked" : "")>
                        <span class="radio @(!myEvents.Any() ? "on" : "")"></span>
                        <div>
                            <div style="font-weight:700;font-size:15.5px;color:var(--w-green-800);">Create a new event</div>
                            <div class="muted mt-1" style="font-size:13.5px;">Set an event name, type, date and budget, then add more services under it.</div>
                        </div>
                    </label>
                    <label class="opt ev-opt mb-0" data-href="@Url.RouteUrl("customer.bookings.details", new { provider_service_id = providerService.ProviderServiceId, date = selectedDate, time = selectedTime })">
                        <input type="radio" name="ev_choice" class="d-none">
                        <span class="radio"></span>
                        <div>
                            <div style="font-weight:700;font-size:15.5px;color:var(--w-green-800);">Book this service on its own</div>
                            <div class="muted mt-1" style="font-size:13.5px;">No event is created. Use this when you only need one service.</div>
                        </div>
                    </label>
                </div>
                <div class="modal-foot d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-w-ghost" data-bs-dismiss="modal">Back</button>
                    <button type="button" class="btn btn-w" id="ev-continue">Continue</button>
                </div>
            </div>

            <form method="post" action="@Url.RouteUrl("customer.myevents.store")" id="pane-create" @(!reopenCreate ? "class=\"d-none\"" : "")>
                @Html.AntiForgeryToken()
                <input type="hidden" name="continue_service" value="@providerService.ProviderServiceId">
                <input type="hidden" name="continue_date" value="@selectedDate">
                <input type="hidden" name="continue_time" value="@selectedTime">
                <div class="modal-head modal-photo-head d-flex justify-content-between align-items-start">
                    <div>
                        <div class="lbl">Step 1 of 3 &middot; New event</div>
                        <h2 class="h-sec mt-1 mb-0">Create your event</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="muted mb-4" style="font-size:14.5px;">General information only. The venue, the time and the guest count are entered on each booking.</p>
                    <div class="field">
                        <label for="ev_name">Event name</label>
                        <input type="text" name="event_name" id="ev_name" class="inp @(errors.Has("event_name") ? "inp-err" : "")" value="@Flash.Old(ViewContext.HttpContext, "event_name")" maxlength="150" required placeholder="Alanoud's Wedding">
                        @if (errors.Has("event_name")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("event_name")</div> }
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6"><div class="field">
                            <label for="ev_type">Event type</label>
                            <div class="inp-icon"><i class="bi bi-tag"></i>
                                <select name="event_type" id="ev_type" class="inp @(errors.Has("event_type") ? "inp-err" : "")" required>
                                    <option value="">Select type</option>
                                    @foreach (var t in eventTypes)
                                    {
                                        <option value="@t" @(Flash.Old(ViewContext.HttpContext, "event_type") == t ? "selected" : "")>@t</option>
                                    }
                                </select></div>
                            @if (errors.Has("event_type")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("event_type")</div> }
                        </div></div>
                        <div class="col-sm-6"><div class="field">
                            <label for="ev_date">Event date</label>
                            <div class="inp-icon"><i class="bi bi-calendar3"></i>
                                <input type="date" name="event_date" id="ev_date" class="inp @(errors.Has("event_date") ? "inp-err" : "")" value="@(Flash.Old(ViewContext.HttpContext, "event_date") ?? selectedDate)" required min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"></div>
                            @if (errors.Has("event_date")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("event_date")</div> }
                        </div></div>
                    </div>
                    <div class="field">
                        <label for="ev_budget">Total budget (SAR)</label>
                        <div class="inp-icon"><i class="bi bi-wallet2"></i>
                            <input type="number" name="total_budget" id="ev_budget" class="inp @(errors.Has("total_budget") ? "inp-err" : "")" value="@Flash.Old(ViewContext.HttpContext, "total_budget")" min="0" step="0.01" placeholder="12000"></div>
                        <div class="help">Wijha warns you when your bookings pass this amount. It never blocks a booking.</div>
                        @if (errors.Has("total_budget")) { <div class="help-err"><i class="bi bi-exclamation-circle"></i> @errors.First("total_budget")</div> }
                    </div>
                    <div class="alert-w a-info mb-0">
                        <i class="bi bi-basket" style="font-size:18px;"></i>
                        <div>@providerService.OfferingTitle (SAR @price.ToString("N0")) will be the first booking added to this event.</div>
                    </div>
                </div>
                <div class="modal-foot d-flex justify-content-end gap-2 flex-wrap">
                    <button type="button" class="btn btn-w-ghost" id="ev-back">Back</button>
                    <button type="submit" class="btn btn-w">Create event and continue</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
<script>
(function () {
    const modalEl = document.getElementById('event-modal');
    if (!modalEl) return;
    const choose = document.getElementById('pane-choose');
    const create = document.getElementById('pane-create');
    const opts = modalEl.querySelectorAll('.ev-opt');
    const show = function (pane) {
        choose.classList.toggle('d-none', pane !== 'choose');
        create.classList.toggle('d-none', pane !== 'create');
    };
    opts.forEach(function (opt) {
        opt.addEventListener('click', function () {
            opts.forEach(function (o) { o.classList.remove('on'); o.querySelector('.radio').classList.remove('on'); });
            opt.classList.add('on');
            opt.querySelector('.radio').classList.add('on');
            opt.querySelector('input').checked = true;
        });
    });
    document.getElementById('ev-continue').addEventListener('click', function () {
        const picked = modalEl.querySelector('.ev-opt.on');
        if (!picked) return;
        if (picked.dataset.pane === 'create') { show('create'); document.getElementById('ev_name').focus(); return; }
        window.location.href = picked.dataset.href;
    });
    document.getElementById('ev-back').addEventListener('click', function () { show('choose'); });
    modalEl.addEventListener('hidden.bs.modal', function () { show('choose'); });
    if (modalEl.dataset.openCreate === '1') bootstrap.Modal.getOrCreateInstance(modalEl).show();
})();
</script>
}
